{{!--
  5E (2024) — the generic front.

    front-title     the name, under the band
    front-subtitle  the italic line under the name, where set:
                    "Rogue feature, 1st level"
    front-body      the text as markdown: paragraphs, lists, tables,
                    `###` sub-headings and embedded pictures, as the
                    note writes them

  The card knows no structure of its own; what the text needs, the note
  writes. What must stay together goes between `%% keep-together %%`
  and `%% /keep-together %%`, a hard break is `%% card-break %%`.
--}}
<div class="card-root card-front ff generic-card">
  <div class="ff-band"></div>
  <div class="card-header ff-header">
    <div class="card-title ff-title"><span class="text-scalable">{{slot "front-title" plain=true}}<span class="cs-overflow-counter"></span></span></div>
  </div>
  <div class="card-content-container">
    <div class="card-body-scalable">
    {{#if (slot "front-subtitle")}}<p class="ff-subtitle">{{slot "front-subtitle"}}</p>{{/if}}
    <div class="ff-text ff-generic-body">{{slot "front-body" markdown="block"}}</div>
    </div>
  </div>
</div>

{{!--
  5E (2014) — the back. One face whatever the note sets: the label, the
  picture, the name, between the orange bars.

    back-heading the label the note sets, else the card type's
    back-image   the picture, fitted whole, its edges faded into the
                 parchment; without one, a d20 in the heading red
    back-title   the name
--}}
<div class="card-root card-back dd {{card-type}}-card {{card-type}}-back">
  <div class="dd-bar"></div>
  <div class="dd-back-label">{{slot "back-heading" plain=true fallback=(t "back-label")}}</div>
  <div class="dd-back-picture">
    {{#if (slot "back-image")}}
    <img class="fade-edges" src="{{slot "back-image" image=true}}" alt="" />
    {{else}}
    <div class="dd-d20">{{asset "assets/d20-mark.svg" inline=true}}</div>
    {{/if}}
  </div>
  <div class="dd-back-name"><span class="text-scalable">{{slot "back-title" plain=true}}</span></div>
  <div class="dd-bar"></div>
</div>

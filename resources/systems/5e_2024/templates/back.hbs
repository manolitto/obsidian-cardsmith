{{!--
  5E (2024) — the back of every card type. One face whatever the note
  sets: the label, the picture, the name.

    back-heading the label the note sets, else the card type's; a
                 creature's type, an item's category
    back-origin  where the card comes from, after the label and a slash
                 when both show — a feature's class, race or background,
                 a spell's school
    back-image   the picture, fitted whole, its edges faded into the
                 paper; without one, a d20 in the card type's colour
    back-title   the name
--}}
<div class="card-root card-back ff {{card-type}}-card {{card-type}}-back">
  <div class="ff-band"></div>
  <div class="ff-back-label">{{slot "back-heading" plain=true fallback=(t "back-label")}}{{#if (slot "back-origin")}}{{#if (slot "back-heading" plain=true fallback=(t "back-label"))}} /{{/if}} <span class="ff-back-origin">{{slot "back-origin" plain=true}}</span>{{/if}}</div>
  <div class="ff-back-picture">
    {{#if (slot "back-image")}}
    <img class="fade-edges" src="{{slot "back-image" image=true}}" alt="" />
    {{else}}
    <div class="ff-d20">{{asset "assets/d20-mark.svg" inline=true}}</div>
    {{/if}}
  </div>
  <div class="ff-back-name">{{slot "back-title" plain=true}}</div>
</div>

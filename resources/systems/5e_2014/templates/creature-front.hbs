{{!--
  5E (2014) — the creature front: the block, then the sections a
  legendary creature adds, each where it is set.

    front-legendary-actions, front-lair-actions,
    front-regional-effects                       sections under their
                                                 heads, each opened by
                                                 its preamble

    front-tracker   the boxes to tick, under a rule, last
--}}
<div class="card-root card-front dd creature-card">
  <div class="dd-bar"></div>
  <div class="card-header dd-header">
    <div class="card-title dd-title"><span class="text-scalable">{{slot "front-title" plain=true}}<span class="cs-overflow-counter"></span></span></div>
  </div>
  <div class="card-content-container">
    <div class="card-body-scalable">
    {{> statblock}}
    {{> entries for="front-legendary-actions" head=true}}
    {{> entries for="front-lair-actions" head=true}}
    {{> entries for="front-regional-effects" head=true}}
    {{> tracker}}
    </div>
  </div>
  <div class="dd-bar"></div>
</div>
